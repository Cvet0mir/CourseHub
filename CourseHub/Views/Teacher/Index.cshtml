@model IEnumerable<CourseHub.ViewModels.Teacher.TeacherIndexViewModel>
@{
    ViewData["Title"] = "Teachers";
}

<h1>Teachers List</h1>

<table>
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.FullName)</th>
            <th>@Html.DisplayNameFor(m => m.MainSubject)</th>
            <th>@Html.DisplayNameFor(m => m.YearsExperience)</th>
            <th>@Html.DisplayNameFor(m => m.Age)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var teacher in Model)
        {
            <tr>
                <td>@teacher.FullName</td>
                <td>@teacher.MainSubject</td>
                <td>@teacher.YearsExperience</td>
                @if (teacher.Age == null)
                {
                    <td>N/A</td>
                }
                else
                {
                    <td>@teacher.Age</td>
                }
                <td>
                    <a asp-action="Details" asp-route-id="@teacher.Id">Details</a> |
                    <a asp-action="Edit" asp-route-id="@teacher.Id">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@teacher.Id">Delete</a>
                </td>
            </tr>
        }
</table>

