
@model CourseHub.ViewModels.Teacher.TeacherCreateViewModel

<h1>Hire a Teacher</h1>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="FirstName"></label>
        <input asp-for="FirstName">
        <span asp-validation-for="FirstName"></span>
    </div>

    <div class="form-group">
        <label asp-for="LastName"></label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="MainSubject"></label>
        <input asp-for="MainSubject" class="form-control" />
        <span asp-validation-for="MainSubject" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="YearsExperience"></label>
        <input asp-for="YearsExperience" class="form-control" />
        <span asp-validation-for="YearsExperience" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Age"></label>
        <input asp-for="Age" class="form-control" />
        <span asp-validation-for="Age" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Hire</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
