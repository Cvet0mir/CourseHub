@model IEnumerable<CourseHub.ViewModels.Course.CourseIndexViewModel>
@{
    ViewData["Title"] = "Courses";
}

<h1>Courses List</h1>

<table>
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Id)</th>
            <th>@Html.DisplayNameFor(m => m.Name)</th>
            <th>@Html.DisplayNameFor(m => m.Subject)</th>
            <th>@Html.DisplayNameFor(m => m.StartDate)</th>
            <th>@Html.DisplayNameFor(m => m.EndDate)</th>
            <th>@Html.DisplayNameFor(m => m.Difficulty)</th>
            <th>@Html.DisplayNameFor(m => m.TeacherFullName)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var course in Model)
        {
            <tr>
                <td>@course.Id</td>
                <td>@course.Name</td>
                <td>@course.Subject</td>
                <td>@course.StartDate.ToShortDateString()</td>
                <td>@course.EndDate.ToShortDateString()</td>
                <td>@course.Difficulty</td>
                <td>@course.TeacherFullName</td>
                <td>
                    <a asp-action="Details" asp-route-id="@course.Id">Details</a> |
                    <a asp-action="Edit" asp-route-id="@course.Id">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@course.Id">Delete</a>
                </td>
            </tr>
        }
</table>
