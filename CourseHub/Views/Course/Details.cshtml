
@model CourseHub.ViewModels.Course.CourseDataViewModel

<h1>Course Details</h1>

<div>
    <h2>@Model.Name</h2>
    <p><b>Subject:</b> @Model.Subject</p>
    <p><b>Start Date:</b> @Model.StartDate.ToShortDateString()</p>
    <p><b>End Date:</b> @Model.EndDate.ToShortDateString()</p>
    <p><b>Difficulty:</b> @Model.Difficulty</p>
    <p><b>Teacher:</b> @Model.TeacherFullName</p>
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
<a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>
